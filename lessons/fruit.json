      "lines": [
        "Do you like oranges?",
        "Yes, I do. I like oranges.",
        "Do you like watermelons?",
        "No, I don't. I don't like watermelons."
      ]
    },
    {
      "id": "hear", "type": "listen", "title": "👂 Listen & Pop!",
      "hint": "Listen, then tap the fruit you heard.",
      "items": { "select": "all" }, "choices": 2
    },
    {
      "id": "build", "type": "scramble", "title": "🧩 Build the Sentence",
      "hint": "Tap the words in order: I → like → fruit.",
      "items": { "select": "new" }, "template": "I like {en}."
    },
    {
      "id": "stand", "type": "phrases", "title": "🛒 The Fruit Stand",
      "hint": "One is the shopkeeper, one is the customer. Then swap!",
      "only": ["a"],
      "lines": [
        "What do you like?",
        "I like oranges.",
        "I like pears.",
        "Why do you like them?",
        "Because they are juicy."
      ]
    },
    {
      "id": "stand-more", "type": "phrases", "title": "🛒 The Fruit Stand",
      "hint": "One is the shopkeeper, one is the customer. Then swap!",
      "only": ["b"],
      "lines": [
        "What do you like?",
        "I like grapes.",
        "I like watermelons.",
        "Why do you like them?",
        "Because they are sweet."
      ]
    },
    {
      "id": "prefer", "type": "phrases", "title": "⚖️ This or That?",
      "hint": "Which do you prefer? Finish the sentence with your own reason!",
      "only": ["b"],
      "lines": [
        "Which do you prefer?",
        "I prefer grapes to pears because they are sweeter.",
        "I prefer watermelons to oranges because they are more refreshing."
      ]
    },
    {
      "id": "talk", "type": "phrases", "title": "🎤 Talk Time",
      "hint": "Ask, then answer in a full sentence. Swap roles each time.",
      "only": ["b"],
      "lines": [
        "What fruit do you like?",
        "What's your favourite fruit?",
        "What colour is your favourite fruit?",
        "Do you like fruit salad?"
      ]
