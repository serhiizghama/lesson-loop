  "blocks": [
    {
      "id": "vocab", "type": "cards", "title": "🔊 Meet the Fruit!",
      "hint": "Tap a card to hear it. Clap the syllables, then say it: whisper, normal, loud!",
      "items": { "select": "new"  }, "front": "emoji", "back": ["en", "tag:syl", "l1"]
    },
    {
      "id": "say", "type": "sentence", "title": "💬 I Like…",
      "hint": "Choose a fruit. Then grow your sentence, one step at a time.",
      "items": { "select": "new"  },
      "levels": [
        { "label": "One word", "template": "{en}" },
        { "label": "I like…", "template": "I like {en}." },
        { "label": "Because…", "template": "I like {en}. {it} {be} {tag:why}." }
      ]
    },
    {
      "id": "more", "type": "combine", "title": "🚀 Say More!",
      "hint": "Build a bigger sentence: feeling + fruit + because. Then say it in your own voice!",
      "only": ["all"],
      "items": { "select": "all" },
      "rows": [
        { "id": "feel", "label": "1️⃣ How do you feel?", "options": [
          { "text": "I like", "mood": "good" },
          { "text": "I really like", "mood": "good" },
          { "text": "I love", "mood": "good" },
          { "text": "I don't like", "mood": "bad" },
          { "text": "I don't really like", "mood": "bad" }
        ] },
        { "items": true, "label": "2️⃣ Which fruit?" },
        { "id": "why", "label": "3️⃣ Why? Because…", "options": [
          { "text": "they are sweet", "mood": "good" },
          { "text": "they are juicy", "mood": "good" },
          { "text": "they are crunchy", "mood": "good" },
          { "text": "they are fresh", "mood": "good" },
          { "text": "they are healthy", "mood": "good" },
          { "text": "they are refreshing", "mood": "good" },
          { "text": "they are delicious", "mood": "good" },
          { "text": "they are sour", "mood": "bad" },
          { "text": "they are too sweet", "mood": "bad" },
          { "text": "they are too soft", "mood": "bad" },
          { "text": "they are too sticky", "mood": "bad" },
          { "text": "they are too messy", "mood": "bad" }
        ] }
      ],
      "template": "{row:feel} {en} because {row:why}."
    },
    {
      "id": "ask", "type": "yesno", "title": "❓ Ask & Answer",
      "hint": "Say your answer first, then tap Yes or No!",
      "only": ["all"],
      "items": { "select": "all"  },
      "question": "Do you like {en}?",
      "yes": "Yes, I do. I like {en}.",
      "no": "No, I don't. I don't like {en}."
    },
    {
      "id": "guess", "type": "reveal", "title": "🙈 Guess & Say",
      "hint": "What is hiding? Guess out loud first, then peek, then reveal!",
      "items": { "select": "new" }, "speak": "I like {en}."
    },
    {
      "id": "hear", "type": "listen", "title": "👂 Listen & Pop!",
      "hint": "Listen, then tap the fruit you heard.",
      "items": { "select": "all"  }, "choices": 2
    },
    {
      "id": "build", "type": "scramble", "title": "🧩 Build the Sentence",
      "hint": "Tap the words in order: I → like → fruit.",
      "items": { "select": "new"  }, "template": "I like {en}."
    },
    {
      "id": "stand", "type": "dialogue", "title": "🛒 The Fruit Stand",
      "hint": "One is the shopkeeper, one is the customer. Then swap!",
      "items": { "select": "new" }, "roles": ["🛒 Shopkeeper", "🧑 Customer"],
      "lines": [
        { "role": 0, "text": "What do you like?" },
        { "role": 1, "text": "I like {en}." },
        { "role": 0, "text": "Why do you like them?" },
        { "role": 1, "text": "Because they are {tag:why}." }
      ]
    },
    {
      "id": "prefer", "type": "prefer", "title": "⚖️ This or That?",
      "hint": "Which do you prefer? Then finish it: because…",
      "only": ["all"],
      "items": { "select": "all"  }, "rounds": 3,
      "sentence": "I prefer {en} to {other}."
    },
    {
      "id": "talk", "type": "talk", "title": "🎤 Talk Time",
      "hint": "Ask, then answer in a full sentence. Press Harder when it was easy!",
      "only": ["all"],
      "levels": [
        { "label": "Level 1", "lines": [
          "What fruit do you like?",
          "What's your favourite fruit?",
          "What colour is your favourite fruit?",
          "Do you like fruit salad?"
        ] },
        { "label": "Level 2", "lines": [
          "Why do you like it?",
          "How does it taste?",
          "When do you usually eat it?",
          "Do you eat it fresh or as juice?"
        ] },
        { "label": "Level 3", "lines": [
          "Which fruit don't you like? Why not?",
          "Which fruit is best on a hot day? Why?",
          "What fruit grows in your country?",
          "If you could eat only one fruit for a year, which one and why?"
        ] }
      ]
    },
    { "id": "done", "type": "finish", "title": "🎉 Great job!", "message": "Great job! Now you can talk about fruit!" }
  ]
}
