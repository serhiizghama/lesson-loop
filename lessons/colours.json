  "blocks": [
    {
      "id": "vocab",
      "type": "cards",
      "title": "🎨 What Colour Is It?",
      "hint": "Tap a colour to hear it and see the Japanese word.",
      "items": {
        "select": "new"
      },
      "front": "emoji",
      "back": [
        "en",
        "l1"
      ]
    },
    {
      "id": "things",
      "type": "cards",
      "title": "🍎 Colours Around Us",
      "hint": "Tap a colour to hear something that has it.",
      "items": {
        "select": "new"
      },
      "front": "emoji",
      "back": [
        "en",
        "tag:thing"
      ],
      "speak": "{en} — like {tag:thing}!"
    },
    {
      "id": "pairs",
      "type": "match",
      "title": "🎯 Matching Game",
      "only": [
        "more"
      ],
      "hint": "Tap the colour, then tap the matching word.",
      "items": {
        "select": "all"
      },
      "left": "emoji",
      "right": "en",
      "count": 6
    },
    {
      "id": "say",
      "type": "sentence",
      "title": "💬 Say It Bigger!",
      "hint": "Choose a colour. Then grow your sentence, one step at a time.",
      "items": {
        "select": "new"
      },
      "levels": [
        {
          "label": "One word",
          "template": "{en}"
        },
        {
          "label": "It is…",
          "template": "{it} {be} {en}."
        },
        {
          "label": "I like…",
          "template": "I like {en}."
        }
      ]
    },
    {
      "id": "hear",
      "type": "listen",
      "title": "👂 Which Colour Is It?",
      "hint": "Listen, then tap the colour you heard.",
      "items": {
        "select": "all"
      },
      "choices": 4
    },
    {
      "id": "thingmatch",
      "type": "match",
      "title": "🔗 What Is That Colour?",
      "hint": "Tap a colour, then tap the thing that has it.",
      "items": {
        "select": "tag",
        "tag": "thing"
      },
      "left": "emoji",
      "right": "tag:thing",
      "count": 5,
      "speak": "{en} — like {tag:thing}!"
    },
    {
      "id": "where",
      "type": "sort",
      "title": "🔍 Where Did We See It?",
      "hint": "Tap a colour, then tap where we saw it.",
      "items": {
        "select": "all"
      },
      "by": "where",
      "buckets": [
        {
          "key": "sky",
          "label": "In the sky",
          "emoji": "☁️"
        },
        {
          "key": "garden",
          "label": "In the garden",
          "emoji": "🌳"
        },
        {
          "key": "plate",
          "label": "On my plate",
          "emoji": "🍽️"
        }
      ]
    },
    {
      "id": "touch",
      "type": "tpr",
      "title": "🎮 Colour Hunt!",
      "hint": "Listen, then run and touch that colour!",
      "items": {
        "select": "all"
      },
      "prompt": "Touch something {en}!"
    },
    {
      "id": "done",
      "type": "finish",
      "title": "🎉 Great job!",
      "message": "Great job learning colours!"
    }
  ]
